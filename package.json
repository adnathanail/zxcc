{
  "name": "@adnathanail/zxcc",
  "version": "0.5.0",
  "description": "Framework-agnostic web component for rendering ZX-calculus diagrams",
  "keywords": [
    "zx-calculus",
    "quantum",
    "quantum-computing",
    "web-component",
    "custom-element",
    "lit",
    "pyzx"
  ],
  "author": "Alex Nathanail",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adnathanail/zxcc.git"
  },
  "homepage": "https://github.com/adnathanail/zxcc#readme",
  "bugs": {
    "url": "https://github.com/adnathanail/zxcc/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "24",
      "onFail": "download"
    }
  },
  "type": "module",
  "main": "./dist/index.bundle.js",
  "module": "./dist/index.bundle.js",
  "types": "./dist/index.bundle.d.ts",
  "sideEffects": true,
  "exports": {
    ".": {
      "types": "./dist/index.bundle.d.ts",
      "import": "./dist/index.bundle.js"
    },
    "./constants": {
      "types": "./dist/constants.d.ts",
      "import": "./dist/constants.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build --stats-json",
    "prepare": "vp config"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@arethetypeswrong/core": "^0.18.5",
    "@storybook/addon-vitest": "^10.6.1",
    "@storybook/web-components-vite": "^10.6.1",
    "@types/node": "^26.2.0",
    "@vitest/browser-playwright": "5.0.3",
    "@vitest/coverage-v8": "5.0.3",
    "chromatic": "^18.2.0",
    "playwright": "latest",
    "publint": "^0.3.25",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.6.1",
    "typescript": "^5.0.3",
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vite-plus": "1.1.0",
    "vitest": "5.0.3"
  },
  "overrides": {
    "vite": "npm:@voidzero-dev/vite-plus-core@1.1.0",
    "vitest": "5.0.3",
    "storybook": {
      "vite-plus": "$vite-plus"
    }
  }
}
