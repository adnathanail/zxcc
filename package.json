{
  "name": "@adnathanail/zxcc",
  "version": "0.3.0",
  "description": "Framework-agnostic web component for rendering ZX-calculus diagrams",
  "keywords": [
    "zx-calculus",
    "quantum",
    "quantum-computing",
    "web-component",
    "custom-element",
    "lit",
    "pyzx"
  ],
  "author": "Alex Nathanail",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/adnathanail/zxcc.git"
  },
  "homepage": "https://github.com/adnathanail/zxcc#readme",
  "bugs": {
    "url": "https://github.com/adnathanail/zxcc/issues"
  },
  "engines": {
    "node": ">=20"
  },
  "type": "module",
  "main": "./dist/index.bundle.js",
  "module": "./dist/index.bundle.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.bundle.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc && rollup -c --environment NODE_ENV:production",
    "analyze": "tsc && rollup -c --environment NODE_ENV:production,ANALYZE:true",
    "build-dev": "tsc && rollup -c --environment NODE_ENV:development",
    "watch": "rollup -c --environment NODE_ENV:development --watch",
    "storybook": "storybook dev -p 6006",
    "build-storybook": "storybook build",
    "test": "vitest run",
    "coverage": "vitest run --coverage",
    "typecheck-stories": "tsc -p tsconfig.stories.json",
    "lint": "biome check && npm run typecheck-stories",
    "format": "biome format --write",
    "fix": "biome check --write"
  },
  "dependencies": {
    "lit": "^3.2.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.4.14",
    "@rollup/plugin-commonjs": "^28.0.1",
    "@rollup/plugin-node-resolve": "^15.3.0",
    "@rollup/plugin-replace": "^6.0.1",
    "@rollup/plugin-terser": "^0.4.4",
    "@storybook/addon-vitest": "^10.5.8",
    "@storybook/web-components-vite": "^10.5.8",
    "@types/node": "^26.2.0",
    "chromatic": "^18.2.0",
    "rollup": "^4.17.2",
    "rollup-plugin-visualizer": "^7.0.1",
    "storybook": "^10.5.8",
    "typescript": "^5.0.3",
    "vite": "^7.3.6",
    "vitest": "latest",
    "playwright": "latest",
    "@vitest/browser-playwright": "latest",
    "@vitest/coverage-v8": "latest"
  }
}
